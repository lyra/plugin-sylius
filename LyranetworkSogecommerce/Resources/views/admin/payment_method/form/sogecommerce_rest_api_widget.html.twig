{% set form = hookable_metadata.context.form.gatewayConfig.config.sogecommerce_rest_api_widget %}
{% set widgetPreview = getWidgetPreview() %}

<div class="col-12">
    <div class="row align-items-center">
        <div class="col-6">
            <p>
                {{ 'sylius_sogecommerce_plugin.ui.sogecommerce_widget_desc' | trans }}
            </p>
            <button id="sogecommerce_widget" onclick="event.preventDefault(); window.epsilon.open();" class="btn btn-primary">
                {{ ux_icon('mingcute:brush-3-fill') }}
                {{ 'sylius_sogecommerce_plugin.ui.sogecommerce_open_widget' | trans }}
            </button>
        </div>
        <div class="col-5">
            <img src="{{ widgetPreview }}">
        </div>
    </div>

    <div class="mt-3">
        {{ form_row(form, sylius_test_form_attribute('config-sogecommerce-rest-api-widget')) }}
    </div>
</div>