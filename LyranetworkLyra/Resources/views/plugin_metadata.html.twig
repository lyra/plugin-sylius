{% set pluginMetadata = getPluginMetadata() %}

<div class="m-2 col-12 alert alert-info">
    <div class="d-flex">
        <div>
            {{ ux_icon('tabler:info-circle', {'class': 'icon alert-icon'}) }}
        </div>
        <div>
            {{ 'sylius_lyra_plugin.ui.lyra_rest_check_url.helptext' | trans }}
        </div>
    </div>
</div>

<h2 class="card-header">
    {{ 'sylius_lyra_plugin.ui.lyra_plugin_credits' | trans }}
</h2>
<div class="row">
    <div class="m-2 col-12">
        {{ 'sylius_lyra_plugin.ui.lyra_developed_by'|trans }}
        <b><a href="https://www.lyra.com/" target="_blank" class="text-primary">Lyra Network</a></b>
    </div>
    <div class="m-2 col-12">
        {{ 'sylius_lyra_plugin.ui.lyra_contact'|trans }}
        <b>{{ pluginMetadata.contactSupport | raw }}</b>
    </div>

    <div class="m-2 col-12">
        {{ 'sylius_lyra_plugin.ui.lyra_module_version'|trans }} <b>{{ pluginMetadata.pluginVersion }}</b>
    </div>

    <div class="m-2 col-12 alert alert-info">
        <div class="d-flex">
            <div>
                {{ ux_icon('tabler:info-circle', {'class': 'icon alert-icon'}) }}
            </div>
            <div>
                {{ 'sylius_lyra_plugin.ui.lyra_documentation_link'|trans }}
            </div>
            <div>
                <a style="margin-left: 10px; font-weight: bold; color: var(--tblr-info)" href="{{ pluginMetadata.docUrl }}" target="_blank">{{ 'sylius_lyra_plugin.ui.lyra_here' | trans }}</a>
            </div>
        </div>
    </div>
</div>