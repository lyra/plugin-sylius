{% set payment = hookable_metadata.context.payment %}
{% set lyraGateway = constant('Lyranetwork\\Lyra\\Sdk\\Tools::FACTORY_NAME') %}
<td class="py-2">
    <strong {{ sylius_test_html_attribute('payment-method') }}>{{ payment.method.name }}</strong>
    {% if payment.details['lyra_factory_name'] is defined and payment.details['transactions'] is defined and payment.details['lyra_factory_name'] is same as (lyraGateway) %}
        <div id="lyraPaymentDetails">
            {% for transUuid, details in payment.details['transactions']%}
                <p>
                    {% if details['lyra_operation_type'] is defined and details['lyra_operation_type'] is not empty %}
                        {{ 'sylius_lyra_plugin.ui.operation_type'|trans }}{{ details['lyra_operation_type'] }}<br>
                    {%endif%}
                    {{ 'sylius_lyra_plugin.ui.transaction_uuid'|trans }}{{ transUuid }}<br>
                    {% if details['lyra_trans_id'] is defined and details['lyra_trans_id'] is not empty %}
                        {{ 'sylius_lyra_plugin.ui.transaction_id'|trans }}{{ details['lyra_trans_id'] }}<br>
                    {%endif%}
                    {% if details['lyra_card_brand'] is defined and details['lyra_card_brand'] is not empty %}
                        {{ 'sylius_lyra_plugin.ui.card_brand'|trans }}{{ details['lyra_card_brand'] }}<br>
                    {%endif%}
                    {% if details['lyra_trans_status'] is defined and details['lyra_trans_status'] is not empty %}
                        {{ 'sylius_lyra_plugin.ui.trans_status'|trans }}{{ details['lyra_trans_status'] }}<br>
                    {%endif%}
                </p>
            {% endfor %}
        </div>
    {% endif %}
</td>